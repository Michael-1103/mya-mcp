# Copier en .env puis adapter. Ne jamais committer le .env réel.

# Obligatoire : token Bearer attendu des clients. Générer avec : openssl rand -hex 32
MCP_AUTH_TOKEN=remplacer-par-un-token-aleatoire-long

# Heure UTC (0-23) du refresh quotidien
REFRESH_HOUR_UTC=3

# Port d'écoute (host 0.0.0.0 dans le conteneur)
PORT=8000

# Dossier de la base SQLite (volume persistant)
DATA_DIR=/data

# Niveau de logs : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Développement local uniquement : démarrer sans authentification (1 pour activer)
# ALLOW_NO_AUTH=1
