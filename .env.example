# Copier en .env puis adapter. Ne jamais committer le .env réel.

# Obligatoire : mot de passe de la page de connexion OAuth (12 caractères minimum).
# Générer avec : openssl rand -hex 32
MCP_PASSWORD=remplacer-par-un-mot-de-passe-aleatoire-long

# Obligatoire : URL publique du serveur, en https, sans chemin ni slash final.
# C'est l'URL que les clients atteignent (derrière votre reverse proxy). Le connecteur sera <PUBLIC_URL>/mcp
PUBLIC_URL=https://mya-mcp.exemple.org

# Heure UTC (0-23) du refresh quotidien
REFRESH_HOUR_UTC=3

# Port d'écoute (host 0.0.0.0 dans le conteneur)
PORT=8000

# Dossier des bases SQLite (volume persistant)
DATA_DIR=/data

# Niveau de logs : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# IP du reverse proxy autorisées à fournir X-Forwarded-For/Proto ("*" = toutes, voir le README)
# FORWARDED_ALLOW_IPS=*

# Développement local uniquement : démarrer sans aucune authentification (1 pour activer)
# ALLOW_NO_AUTH=1
